<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 通知周期 Job 使用 NETWORK_TYPE_ANY；不声明该权限时 JobScheduler.schedule 会抛
         SecurityException，导致后台通知任务根本注册不上（只有前台刷新才会推通知） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 应用内下载 release APK 后唤起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 14+ 起精确闹钟默认被拒绝，必须声明后引导用户开启「闹钟和提醒」 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 引导用户把应用加入电池优化白名单，否则部分 ROM 会直接杀掉后台、闹钟不送达 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 常驻保活：前台服务让检查循环在国产 ROM 上存活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 11+ 包可见性：不声明该 queries 就发现/绑定不了系统 TTS 引擎服务，
         TextToSpeech 初始化会一律失败（系统设置不受此限制，因此那里可以正常试听） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- 需要枚举能接收 APK 的安装器，才能把 FileProvider 的读权限逐个授予它们 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data
                android:mimeType="application/vnd.android.package-archive"
                android:scheme="content" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NekoWeather"
        android:usesCleartextTraffic="false">
        <service
            android:name=".notification.NotificationKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="weather_notification" />
        </service>
        <service
            android:name=".notification.WeatherNotificationJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- 闹钟入口：例行检查与调试用的延迟测试通知 -->
        <receiver
            android:name=".notification.WeatherNotificationAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".notification.WeatherNotificationBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true" />
        <activity-alias
            android:name=".GlobalLauncher"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name_global"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ChineseLauncher"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name_chinese"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
